# -*- mode: yaml -*-
# CS-7374 verify v2: AI review trigger copied from docs/downloads/gitstream.cm
manifest:
  version: 1.0

automations:
  linearb_ai_codereview:
    on: [pr_created, pr_ready_for_review, merge]
    if:
      - {{ not is.bot }}
    run:
      - action: code-review@v1
        args:
          guidelines: |
            - Keep suggestions short and actionable.

is:
  bot: {{ pr.author | match(list=['github-actions', '_bot_', '[bot]', 'dependabot']) | some }}
